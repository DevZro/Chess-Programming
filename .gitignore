# =========================================================
# Chess-Programming
# =========================================================
# Note: Unity .meta files must be committed alongside their
# assets. Never ignore *.meta for anything under Assets/ —
# dropping them breaks GUID references for every other clone.

# --------------------
# Unity: generated / machine-local
# --------------------
UnityProject/[Ll]ibrary/
UnityProject/[Tt]emp/
UnityProject/[Oo]bj/
UnityProject/[Bb]uild/
UnityProject/[Bb]uilds/
UnityProject/[Ll]ogs/
UnityProject/[Uu]serSettings/
UnityProject/[Mm]emoryCaptures/
UnityProject/[Rr]ecordings/
UnityProject/sysinfo.txt

# Unity: Addressables / asset-import artifacts
UnityProject/[Aa]ssets/[Ss]treamingAssets/aa.meta
UnityProject/[Aa]ssets/[Ss]treamingAssets/aa/*
UnityProject/[Aa]ssets/AssetStoreTools*

# Unity: package/tooling noise that gets auto-generated
UnityProject/[Aa]ssets/Plugins/Editor/JetBrains*
UnityProject/.vsconfig
UnityProject/crashlytics-build.properties

# Unity: build outputs
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dmg
*.ipa

# --------------------
# .NET (EngineTests, and any future project)
# --------------------
[Bb]in/
[Oo]bj/

# Build artifacts only. NOT a blanket *.dll — plugin DLLs under
# Assets/ are real project assets and must stay tracked.
EngineTests/**/*.dll
EngineTests/**/*.pdb

# --------------------
# IDE / editor
# --------------------
.vs/
.idea/
.vscode/
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.tmp
*.unityproj

# Unity regenerates these from Assets/ on every open — never commit them.
# Scoped to UnityProject/ so hand-authored project files (EngineTests.csproj)
# stay tracked.
UnityProject/*.csproj
UnityProject/*.sln

# --------------------
# OS files
# --------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
